<?xml version="1.0" encoding="UTF-8"?>
<TigoRecargaTests>

  <!-- ============================================================ -->
  <!--  FLUJO 1: CONSULTA DE DEUDA                                  -->
  <!--  MakeRequest / HandleRequest                                 -->
  <!-- ============================================================ -->
  <Request name="1. Consulta de Deuda" method="POST" endpoint="/api/transactions/debt">
    <Headers>
      <Header key="Content-Type" value="application/json" />
    </Headers>
    <Body>
      <transactionNumber>123456</transactionNumber>
      <teller>T001</teller>
      <branch>1</branch>
      <fields>
        <field>
          <key>NUMCELULAR</key>
          <value>99887766</value>
        </field>
        <field>
          <key>CODPRODUCTO</key>
          <value>TIGO_PREPAGO</value>
        </field>
        <field>
          <key>CODSELECTOR</key>
          <value>SEL01</value>
        </field>
        <field>
          <key>TIPOPRODUCTO</key>
          <value>RECARGA</value>
        </field>
        <field>
          <key>MONEDA</key>
          <value>1</value>
        </field>
        <field>
          <key>TERMSOFIA</key>
          <value>TERM001</value>
        </field>
        <field>
          <key>TNUDOCTRA</key>
          <value>7890</value>
        </field>
      </fields>
    </Body>
    <ExpectedResponse>
      <status>Success</status>
      <message>CONSULTA EXITOSA</message>
      <fieldsReturned>
        <field>IDPAGO</field>
        <field>NUMCELULAR</field>
        <field>DESCRIPCION</field>
        <field>MONTOTOTAL</field>
        <field>CODPRODUCTO</field>
        <field>CODSELECTOR</field>
        <field>TIPOPRODUCTO</field>
        <field>FORMAPAGO</field>
      </fieldsReturned>
    </ExpectedResponse>
    <Validations>
      <validation field="NUMCELULAR" errorIfEmpty="Required(NUMCELULAR)" />
      <validation field="CODPRODUCTO" errorIfEmpty="Required(CODPRODUCTO)" />
    </Validations>
  </Request>

  <!-- ============================================================ -->
  <!--  FLUJO 2: PAGO                                               -->
  <!--  MakePayment / HandlePayment                                 -->
  <!--  Requiere IDPAGO obtenido en el Flujo 1                      -->
  <!-- ============================================================ -->
  <Request name="2. Pago" method="POST" endpoint="/api/transactions/payment">
    <Headers>
      <Header key="Content-Type" value="application/json" />
    </Headers>
    <Body>
      <transactionNumber>123456</transactionNumber>
      <teller>T001</teller>
      <branch>1</branch>
      <fields>
        <!-- Campos heredados de la consulta -->
        <field>
          <key>NUMCELULAR</key>
          <value>99887766</value>
        </field>
        <field>
          <key>CODPRODUCTO</key>
          <value>TIGO_PREPAGO</value>
        </field>
        <field>
          <key>CODSELECTOR</key>
          <value>SEL01</value>
        </field>
        <field>
          <key>TIPOPRODUCTO</key>
          <value>RECARGA</value>
        </field>
        <field>
          <key>MONEDA</key>
          <value>1</value>
        </field>
        <field>
          <key>TNUDOCTRA</key>
          <value>7890</value>
        </field>
        <field>
          <key>FORMAPAGO</key>
          <value>EFECTIVO</value>
        </field>
        <!-- Campos de pago -->
        <field>
          <key>IDPAGO</key>
          <value>PAY-001</value><!-- Obtenido del Flujo 1 -->
        </field>
        <field>
          <key>MONTOTOTAL</key>
          <value>100.00</value>
        </field>
        <field>
          <key>MPAGOACT</key>
          <value>80.00</value><!-- MPAGOACT + MONTOACUM + MPAGOACT2 debe ser igual a MONTOTOTAL -->
        </field>
        <field>
          <key>MONTOACUM</key>
          <value>20.00</value>
        </field>
        <field>
          <key>MPAGOACT2</key>
          <value>0.00</value>
        </field>
        <field>
          <key>COMISION</key>
          <value>0.00</value>
        </field>
      </fields>
    </Body>
    <ExpectedResponse>
      <status>Success</status>
      <message>RECARGA EXITOSA</message>
      <fieldsReturned>
        <field>CHECKSUM</field>
        <field>REFPAGO</field>
      </fieldsReturned>
    </ExpectedResponse>
    <Validations>
      <validation rule="MPAGOACT + MONTOACUM + MPAGOACT2 == MONTOTOTAL"
                  errorIfFail="AmountMatch — Los montos de pago no coinciden con el total" />
    </Validations>
  </Request>

  <!-- ============================================================ -->
  <!--  FLUJO 3: REVERSIÓN                                          -->
  <!--  MakeReverse / HandleReverse                                 -->
  <!--  Solo si el pago fue procesado y necesita revertirse         -->
  <!-- ============================================================ -->
  <Request name="3. Reversión" method="POST" endpoint="/api/transactions/reverse">
    <Headers>
      <Header key="Content-Type" value="application/json" />
    </Headers>
    <Body>
      <transactionNumber>123456</transactionNumber>
      <teller>T001</teller>
      <branch>1</branch>
      <fields>
        <field>
          <key>IDPAGO</key>
          <value>PAY-001</value><!-- Mismo IDPAGO del pago a revertir -->
        </field>
        <field>
          <key>MONEDA</key>
          <value>1</value>
        </field>
        <field>
          <key>MPAGOACT</key>
          <value>80.00</value>
        </field>
        <field>
          <key>MONTOACUM</key>
          <value>20.00</value>
        </field>
        <field>
          <key>TNUDOCTRA</key>
          <value>7890</value>
        </field>
        <field>
          <key>NUMCELULAR</key>
          <value>99887766</value>
        </field>
      </fields>
    </Body>
    <ExpectedResponse>
      <status>Success</status>
      <message>REVERSION EXITOSA</message>
    </ExpectedResponse>
  </Request>

</TigoRecargaTests>
